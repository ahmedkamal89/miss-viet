# ── Required ────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Vercel Postgres, Railway…)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Password the shop uses at /admin, and a long random string to sign the login cookie
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=paste-a-long-random-string-here

# Your live web address (used in emails and Stripe redirects)
SITE_URL=https://missviets.com.au

# ── Card payments (Stripe) ──────────────────────────────────
# Leave blank to offer "pay at pickup" only.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Desktop / phone notifications (Web Push) ────────────────
# Generate once with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# ── Email alerts ────────────────────────────────────────────
# Where new-order emails go
ADMIN_EMAIL=owner@example.com
# Option A: Resend (resend.com), simplest
RESEND_API_KEY=
EMAIL_FROM=Miss Viet's Lunch Bar <orders@yourdomain.com.au>
# Option B: any SMTP account (e.g. Gmail with an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Photo uploads on Vercel ─────────────────────────────────
# Add a Blob store in the Vercel dashboard and this is filled in for you.
BLOB_READ_WRITE_TOKEN=
